      "css": ".ds-capture{padding:22px;border:1px solid #f0e4d6;border-radius:var(--radius,14px);background:#f0e4d6;color:var(--ink,#202e29);font-family:Manrope,Arial,sans-serif}.ds-capture h2{margin:0 0 14px;font-size:17px;font-weight:750;letter-spacing:-.02em}.ds-entry{padding:8px 8px 8px 13px;background:white;border-radius:9px;border:1px solid #e4d8c9}.ds-entry textarea{border:0;outline:none;resize:none;width:100%;min-height:43px;padding:8px 0;background:transparent;font:12px/1.6 Manrope,Arial,sans-serif}.ds-entry:focus-within{outline:2px solid var(--green,#244e3f);outline-offset:2px}"
    },
    {
      "name": "Ask Pocket answer and composer",
      "kind": "custom",
      "refersTo": "assistant-thread",
      "description": "Flat conversation with wrapping scope, source evidence, and an anchored composer.",
      "html": "<section class=\"ds-ask\"><div class=\"ds-question\">Where did my money go?</div><div class=\"ds-scope\"><span>This month</span><span>Expenses</span><span>All accounts</span></div><p class=\"ds-answer\">Your recorded expenses total <strong>RM 240.00</strong>.</p><details class=\"ds-evidence\"><summary>Matching transactions</summary><button><span>Neighborhood market<small>Groceries ? 2 Oct</small></span><strong>RM 240.00</strong></button></details><form class=\"ds-composer\"><textarea aria-label=\"Ask about your money\" placeholder=\"Ask about your spending\"></textarea><button type=\"button\" aria-label=\"Ask Pocket\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button></form></section>",
      "css": ".ds-ask{font-family:Manrope,Arial,sans-serif;background:var(--surface,#fff);color:var(--ink,#202e29);border:1px solid var(--line,#e3e6de);border-radius:var(--radius,14px);padding:23px}.ds-question{margin:0 0 23px auto;max-width:90%;width:fit-content;background:#eaf0e1;border-radius:12px;padding:12px 16px;font-size:13px}.ds-scope{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px}.ds-scope span{padding:3px 7px;border:1px solid var(--line,#e3e6de);border-radius:5px;font-size:11px;color:var(--muted,#647168)}.ds-answer{font-size:13px;line-height:1.85}.ds-evidence{margin-top:19px;border-block:1px solid var(--line,#e3e6de)}.ds-evidence summary{cursor:pointer;padding:13px 0;min-height:44px;font-size:11px;font-weight:700;color:var(--green,#244e3f)}.ds-evidence button{display:flex;justify-content:space-between;gap:13px;width:100%;padding:12px 3px;text-align:left;border:0;border-top:1px solid #edf0e8;background:transparent;font:12px Manrope,Arial,sans-serif;color:var(--ink,#202e29);cursor:pointer}.ds-evidence button:hover{background:#f7f9f2}.ds-evidence small{display:block;font-size:11px;color:var(--muted,#647168);margin-top:3px}.ds-evidence strong{font-variant-numeric:tabular-nums;white-space:nowrap}.ds-composer{display:flex;gap:8px;align-items:flex-end;margin-top:17px;padding:9px 10px 8px 15px;border:1px solid #cdd7c6;border-radius:11px;background:#f9faf6}.ds-composer:focus-within{outline:2px solid var(--green,#244e3f);outline-offset:2px}.ds-composer textarea{flex:1;min-width:0;background:transparent;border:0;outline:none;resize:none;font:13px/1.65 Manrope,Arial,sans-serif;color:var(--ink,#202e29)}.ds-composer button{min-width:38px;min-height:38px;padding:8px;border:0;border-radius:8px;background:var(--green,#244e3f);color:white;cursor:pointer}.ds-composer button:hover{background:var(--green-hover,#183a2e)}.ds-composer button:active{transform:translateY(1px)}.ds-ask button:focus-visible,.ds-ask summary:focus-visible{outline:3px solid #60875b;outline-offset:4px}@media(max-width:760px){.ds-composer textarea{font-size:16px;line-height:1.55}}"
    }
  ],
  "narrative": {
    "northStar": "Neighborhood credit-union booklet",
    "overview": "Pocket is a quiet contemporary household ledger for frequent short visits. Cream paper, forest identity, peach annotations, generous margins, and precise tabular amounts make everyday money feel orderly and approachable. The selected design seed was the fifth direction: neighborhood credit-union booklet.\n\nOperate mode uses familiar application controls and a warm capture area. The implemented system expresses that selected direction through type, tonal surfaces, and spacing rather than a literal paper texture.",
