# Optional. Local OCR and all bookkeeping features work without this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=4317
# Optional together: private, single-user Neon Postgres storage.
# Copy the pooled URL from Neon Console > Connect. Keep TLS verification enabled.
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR_ENDPOINT-pooler.YOUR_REGION.aws.neon.tech/neondb?sslmode=verify-full
# POCKET_ACCESS_PASSWORD=choose-a-long-unique-password
# Optional when hosting on a custom HTTPS domain:
# POCKET_PUBLIC_URL=https://pocket.example
